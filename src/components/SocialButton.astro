---
import type { SocialLink } from '../config/site';

interface Props {
  link: SocialLink;
  index: number;
}

const { link, index } = Astro.props;
const animationDelayClass = `delay-${Math.min(index + 3, 6)}`;
---

<li class={`social-item animate-in ${animationDelayClass}`}>
  <a
    href={link.url}
    target="_blank"
    rel="noopener noreferrer"
    class={`social-button theme-${link.theme}`}
    aria-label={link.ariaLabel}
    id={`btn-${link.id}`}
  >
    <!-- Icono Oficial en Contenedor con Color Auténtico -->
    <div class="icon-container" aria-hidden="true">
      {link.icon === 'instagram' && (
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
      )}

      {link.icon === 'tiktok' && (
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.29 0 .58.04.85.12V9.4a6.33 6.33 0 0 0-.85-.06A6.34 6.34 0 0 0 3.1 15.68a6.34 6.34 0 0 0 10.82 4.48c1.3-1.3 1.98-3.03 1.98-4.88V8.62a8.28 8.28 0 0 0 4.84 1.54V6.71a4.83 4.83 0 0 1-1.15-.02z"/>
        </svg>
      )}

      {link.icon === 'youtube' && (
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
      )}

      {link.icon === 'facebook' && (
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
      )}

      {link.icon === 'whatsapp' && (
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M12.004 2C6.48 2 2 6.478 2 12C2 13.844 2.502 15.572 3.378 17.062L2.096 21.758L6.908 20.514C8.358 21.328 10.024 21.8 11.996 21.8C17.52 21.8 22 17.322 22 11.8C22 6.278 17.52 2 12.004 2ZM12.004 20.088C10.334 20.088 8.804 19.608 7.514 18.776L7.204 18.574L4.254 19.336L5.04 16.468L4.814 16.108C3.896 14.748 3.376 13.112 3.376 11.8C3.376 7.24 7.244 3.372 12.004 3.372C16.764 3.372 20.632 7.24 20.632 11.8C20.632 16.36 16.764 20.088 12.004 20.088Z"/>
        </svg>
      )}
    </div>

    <!-- Textos del Botón -->
    <div class="button-texts">
      <div class="platform-row">
        <span class="platform-name">{link.platform}</span>
        {link.badgeText && (
          <span class="platform-badge">{link.badgeText}</span>
        )}
      </div>
      <span class="username-text">{link.username}</span>
    </div>

    <!-- Flecha indicadora de apertura externa -->
    <div class="action-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17l9.2-9.2M17 17V7H7"/>
      </svg>
    </div>
  </a>
</li>

<style>
  .social-item {
    list-style: none;
    width: 100%;
  }

  .social-button {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    min-height: 68px;
    padding: 0.9rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-spring), background-color var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
    position: relative;
    overflow: hidden;
  }

  /* Estados de interacción táctil y desktop */
  .social-button:hover {
    transform: translateY(-3px) scale(1.01);
    background: var(--bg-card-hover);
    box-shadow: var(--shadow-md);
    border-color: #ffffff;
  }

  .social-button:active {
    transform: translateY(1px) scale(0.99);
  }

  /* Iconos según plataforma */
  .icon-container {
    width: 46px;
    height: 46px;
    min-width: 46px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-spring);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  .social-button:hover .icon-container {
    transform: scale(1.08);
  }

  /* 📸 TEMA OFICIAL INSTAGRAM CON GRADIENTE RADIAL EXACTO */
  .theme-instagram .icon-container {
    background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(214, 36, 159, 0.35);
  }
  .theme-instagram .platform-badge {
    color: #c13584;
    background: rgba(193, 53, 132, 0.1);
    border-color: rgba(193, 53, 132, 0.25);
  }
  .theme-instagram .action-icon {
    color: #c13584;
    background: rgba(193, 53, 132, 0.08);
  }
  .theme-instagram:hover {
    border-color: rgba(193, 53, 132, 0.4);
    box-shadow: 0 10px 25px rgba(193, 53, 132, 0.15);
  }
  .theme-instagram:hover .action-icon {
    background: radial-gradient(circle at 30% 107%, #fd5949 0%, #d6249f 60%, #285AEB 90%);
    color: #ffffff;
  }

  /* 🎵 TEMA OFICIAL TIKTOK */
  .theme-tiktok .icon-container {
    background: #000000;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }
  .theme-tiktok .platform-badge {
    color: #0f172a;
    background: rgba(15, 23, 42, 0.08);
    border-color: rgba(15, 23, 42, 0.15);
  }
  .theme-tiktok:hover {
    border-color: rgba(0, 0, 0, 0.3);
  }

  /* ▶️ TEMA OFICIAL YOUTUBE */
  .theme-youtube .icon-container {
    background: #ff0000;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(255, 0, 0, 0.3);
  }
  .theme-youtube .platform-badge {
    color: #cc0000;
    background: rgba(255, 0, 0, 0.08);
    border-color: rgba(255, 0, 0, 0.2);
  }
  .theme-youtube .action-icon {
    color: #cc0000;
    background: rgba(255, 0, 0, 0.08);
  }
  .theme-youtube:hover {
    border-color: rgba(255, 0, 0, 0.4);
  }
  .theme-youtube:hover .action-icon {
    background: #ff0000;
    color: #ffffff;
  }

  /* 📘 TEMA OFICIAL FACEBOOK */
  .theme-facebook .icon-container {
    background: #1877f2;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(24, 119, 242, 0.3);
  }
  .theme-facebook .platform-badge {
    color: #1877f2;
    background: rgba(24, 119, 242, 0.08);
    border-color: rgba(24, 119, 242, 0.2);
  }
  .theme-facebook .action-icon {
    color: #1877f2;
    background: rgba(24, 119, 242, 0.08);
  }
  .theme-facebook:hover {
    border-color: rgba(24, 119, 242, 0.4);
  }
  .theme-facebook:hover .action-icon {
    background: #1877f2;
    color: #ffffff;
  }

  .button-texts {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .platform-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .platform-name {
    font-size: 1.05rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.25;
  }

  .platform-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    border: 1px solid transparent;
  }

  .username-text {
    font-size: 0.88rem;
    font-weight: 600;
    color: #475569;
    margin-top: 0.1rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .action-icon {
    width: 34px;
    height: 34px;
    min-width: 34px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-normal), background-color var(--transition-fast), color var(--transition-fast);
  }

  .social-button:hover .action-icon {
    transform: translate(2px, -2px);
  }

  @media (max-width: 380px) {
    .social-button {
      padding: 0.75rem 1rem;
      min-height: 62px;
    }
    .platform-name {
      font-size: 0.98rem;
    }
    .username-text {
      font-size: 0.82rem;
    }
    .icon-container {
      width: 40px;
      height: 40px;
      min-width: 40px;
    }
  }
</style>
