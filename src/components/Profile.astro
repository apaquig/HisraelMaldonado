---
import { siteConfig } from '../config/site';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<header class="profile-header animate-in delay-1">
  <!-- Contenedor del Avatar con Anillo Blanco y Borde Celeste Atomy -->
  <div class="avatar-wrapper">
    <div class="avatar-ring">
      <picture>
        <source srcset={`${baseUrl}images/israel-maldonado.webp`} type="image/webp" />
        <img
          src={`${baseUrl}images/israel-maldonado.png`}
          alt={`Fotografía profesional de ${siteConfig.name} - Líder de ${siteConfig.brand}`}
          width="360"
          height="360"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="avatar-image"
        />
      </picture>
    </div>
    
    <!-- Badge de Verificado Oficial Atomy -->
    {siteConfig.verifiedBadge && (
      <div class="verified-badge" title={siteConfig.verifiedText} aria-label={siteConfig.verifiedText}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 2L14.7 4.2L18.1 4.5L19.2 7.7L22.1 9.5L21.4 12.9L22.8 16L20.2 18.2L19.8 21.6L16.4 22.1L14.1 24.6L11 23.3L7.9 24.6L5.6 22.1L2.2 21.6L1.8 18.2L-0.8 16L0.6 12.9L-0.1 9.5L2.8 7.7L3.9 4.5L7.3 4.2L10 2H12Z" fill="#00A0E9"/>
          <path d="M10.2 15.5L7 12.3L8.4 10.9L10.2 12.7L15.6 7.3L17 8.7L10.2 15.5Z" fill="#FFFFFF"/>
        </svg>
      </div>
    )}
  </div>

  <!-- Información de Marca y Nombre -->
  <div class="profile-info">
    <!-- Píldora de Marca con la Imagen Exacta del Logotipo Oficial de ATOMY -->
    <div class="brand-pill">
      <div class="logo-container">
        <img
          src={`${baseUrl}images/atomy-logo.png`}
          alt="Logotipo oficial de ATOMY"
          width="104"
          height="53"
          loading="eager"
          decoding="async"
          class="atomy-official-logo"
        />
      </div>
      <span class="brand-divider" aria-hidden="true">•</span>
      <span class="brand-subtext">{siteConfig.role}</span>
    </div>

    <h1 class="profile-name">{siteConfig.name}</h1>
    
    <p class="profile-tagline">{siteConfig.tagline}</p>
    
    {siteConfig.bio && (
      <p class="profile-bio">{siteConfig.bio}</p>
    )}
  </div>
</header>

<style>
  .profile-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    padding: 0.5rem 0 0.25rem;
  }

  .avatar-wrapper {
    position: relative;
    width: 142px;
    height: 142px;
    margin-bottom: 1.25rem;
  }

  .avatar-ring {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
    padding: 4px;
    background: linear-gradient(135deg, #00A0E9 0%, #ffffff 40%, #0077C8 100%);
    box-shadow: 0 12px 32px rgba(0, 160, 233, 0.3), 0 2px 10px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-spring), box-shadow var(--transition-normal);
  }

  .avatar-wrapper:hover .avatar-ring {
    transform: scale(1.04);
    box-shadow: 0 16px 40px rgba(0, 160, 233, 0.45), 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  .avatar-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    border-radius: var(--radius-full);
    background-color: #f1f5f9;
    border: 2px solid #ffffff;
    display: block;
  }

  .verified-badge {
    position: absolute;
    bottom: 2px;
    right: 2px;
    background: #ffffff;
    border-radius: var(--radius-full);
    padding: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(0, 45, 95, 0.25);
    border: 1.5px solid rgba(0, 160, 233, 0.2);
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    max-width: 480px;
  }

  .brand-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: #ffffff;
    border: 1.5px solid rgba(0, 160, 233, 0.3);
    padding: 0.35rem 1.15rem;
    border-radius: var(--radius-full);
    box-shadow: 0 4px 14px rgba(0, 45, 95, 0.08);
  }

  .logo-container {
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  .atomy-official-logo {
    width: 96px;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .brand-divider {
    color: #94a3b8;
    font-size: 0.85rem;
  }

  .brand-subtext {
    font-size: 0.82rem;
    font-weight: 700;
    color: #004b87;
    letter-spacing: 0.02em;
  }

  .profile-name {
    font-size: 1.95rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #002b54;
    line-height: 1.2;
    margin-top: 0.15rem;
  }

  .profile-tagline {
    font-size: 1rem;
    font-weight: 700;
    color: #0077c8;
    line-height: 1.4;
    letter-spacing: 0.01em;
    background: rgba(255, 255, 255, 0.85);
    padding: 0.25rem 0.95rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(0, 160, 233, 0.25);
    box-shadow: 0 2px 8px rgba(0, 45, 95, 0.06);
  }

  .profile-bio {
    font-size: 0.92rem;
    font-weight: 500;
    color: #1e293b;
    line-height: 1.5;
    margin-top: 0.15rem;
    padding: 0 0.5rem;
  }

  @media (max-width: 380px) {
    .avatar-wrapper {
      width: 124px;
      height: 124px;
    }
    .profile-name {
      font-size: 1.65rem;
    }
    .brand-subtext {
      font-size: 0.74rem;
    }
    .atomy-official-logo {
      width: 84px;
    }
  }
</style>
